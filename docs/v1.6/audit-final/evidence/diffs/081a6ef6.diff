+            return None
+        row = db.execute('SELECT assignment_id FROM team_assignments WHERE job_id=?'
+                         ' AND milestone_id=? ORDER BY created DESC LIMIT 1',
+                         (job_id, milestone_id)).fetchone()
+        if row is None:
+            return None
