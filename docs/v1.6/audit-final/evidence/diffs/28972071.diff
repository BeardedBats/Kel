+  font-weight: 600;
+  color: var(--kel-text-1);
+}
+.kel-failure__detail {
+  margin: 0;
+  font-size: var(--kel-type-body);
+  color: var(--kel-text-2);
+  line-height: 1.5;
+}
+.kel-failure__actions {
+  display: flex;
+  align-items: center;
+  gap: var(--kel-space-3);
+  margin-top: var(--kel-space-3);
+}
+.kel-failure__details {
+  margin-top: var(--kel-space-3);
+  border-top: 1px solid var(--kel-border);
+  padding-top: var(--kel-space-2);
+}
+.kel-failure__details > summary {
+  cursor: pointer;
+  font-size: var(--kel-type-meta);
+  color: var(--kel-text-3);
+}
+.kel-failure__raw {
+  margin: var(--kel-space-2) 0 0;
+  font-family: var(--kel-font-mono);
+  font-size: var(--kel-type-meta);
+  color: var(--kel-text-2);
+  background: var(--kel-surface-0);
+  border: 1px solid var(--kel-border);
+  border-radius: var(--kel-radius-control);
+  padding: 8px 10px;
+  white-space: pre-wrap;
+  overflow: auto;
+  max-height: 220px;
+}
+
+.kel-engine-notice {
+  display: flex;
+  align-items: center;
+  gap: var(--kel-space-3);
+  padding: 6px var(--kel-gutter);
+  font-size: var(--kel-type-label);
+  border-bottom: 1px solid var(--kel-border);
+}
+.kel-engine-notice__text {
+  display: flex;
+  align-items: baseline;
+  gap: var(--kel-space-2);
+  min-width: 0;
