{
  "extends": "./packages/desktop/electron-builder.yml",
  "appId": "com.kel.desktop",
  "productName": "Kel",
  "executableName": "Kel",
  "copyright": "Copyright © 2026 Kel",
  "publish": null,
  "linux": {
    "maintainer": "Kel",
    "vendor": "Kel",
    "icon": "resources/app.png",
    "desktop": {
      "entry": {
        "Name": "Kel",
        "Comment": "Kel desktop application",
        "Icon": "Kel",
        "Categories": "Office;Utility;",
        "MimeType": "x-scheme-handler/kel;"
      }
    }
  },
  "protocols": [
    {
      "name": "Kel",
      "schemes": [
        "kel"
      ]
    }
  ],
  "directories": {
    "output": "../dist/package",
    "app": ".",
    "buildResources": "resources"
  },
  "electronDist": "node_modules/electron/dist",
  "electronVersion": "44.3.0",
  "win": {
    "target": [
      "dir"
    ],
    "icon": "resources/app.ico",
    "signAndEditExecutable": true
  },
  "nsis": {
    "installerIcon": "resources/app.ico",
    "uninstallerIcon": "resources/app.ico",
    "installerHeaderIcon": "resources/app.ico",
    "shortcutName": "Kel"
  },
  "mac": {
    "icon": "resources/app.icns"
  },
  "extraResources": [
    {
      "from": "../dist/runtime/KelEngine",
      "to": "kel-engine"
    },
    {
      "from": "LICENSE",
      "to": "AionUI-LICENSE.txt"
    }
  ]
}